{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moughor/Atlas/docs/schemas/atlas-performance-measurement-v1.schema.json",
  "title": "Atlas Performance Measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregates",
    "filesystem",
    "phase_ids",
    "phase_status",
    "producer",
    "sampling",
    "samples",
    "schema_version"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {"const": "atlas-performance-measurement/1.0"},
    "phase_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"},
      "uniqueItems": true
    },
    "phase_status": {
      "type": "array",
      "items": {"$ref": "#/$defs/phaseStatus"}
    },
    "samples": {
      "type": "array",
      "items": {"$ref": "#/$defs/sample"}
    },
    "sampling": {"$ref": "#/$defs/sampling"},
    "aggregates": {
      "type": "array",
      "items": {"$ref": "#/$defs/phaseAggregate"}
    },
    "filesystem": {"$ref": "#/$defs/filesystem"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "unit": {
      "enum": ["nanoseconds", "bytes", "count", "percent"]
    },
    "reason": {
      "enum": [
        "collection-disabled",
        "platform-unsupported",
        "runtime-unsupported",
        "provider-unavailable",
        "not-recorded",
        "zero-wall-time",
        "tracemalloc-inactive",
        "concurrent-scope-attribution"
        ,"sampled-out"
      ]
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unit", "value"],
          "properties": {
            "status": {"const": "measured"},
            "unit": {"$ref": "#/$defs/unit"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "status", "unit"],
          "properties": {
            "status": {"const": "unsupported"},
            "unit": {"$ref": "#/$defs/unit"},
            "reason": {"enum": ["platform-unsupported", "runtime-unsupported"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "status", "unit"],
          "properties": {
            "status": {"const": "unavailable"},
            "unit": {"$ref": "#/$defs/unit"},
            "reason": {
              "enum": [
                "collection-disabled",
                "provider-unavailable",
                "not-recorded",
                "zero-wall-time",
                "tracemalloc-inactive",
                "concurrent-scope-attribution"
                ,"sampled-out"
              ]
            }
          }
        }
      ]
    },
    "phaseStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase_id", "status"],
          "properties": {
            "phase_id": {"$ref": "#/$defs/identifier"},
            "status": {"const": "measured"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase_id", "reason", "status"],
          "properties": {
            "phase_id": {"$ref": "#/$defs/identifier"},
            "status": {"const": "unavailable"},
            "reason": {"enum": ["collection-disabled", "not-recorded", "sampled-out"]}
          }
        }
      ]
    },
    "sampling": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible_scopes",
            "sample_every",
            "sampled_scopes",
            "phases",
            "status",
            "strategy"
          ],
          "properties": {
            "status": {"const": "measured"},
            "strategy": {"const": "deterministic-hash"},
            "sample_every": {"type": "integer", "minimum": 1},
            "eligible_scopes": {"type": "integer", "minimum": 0},
            "sampled_scopes": {"type": "integer", "minimum": 0}
            ,"phases": {
              "type": "array",
              "items": {"$ref": "#/$defs/phaseSampling"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible_scopes",
            "reason",
            "sample_every",
            "sampled_scopes",
            "phases",
            "status",
            "strategy"
          ],
          "properties": {
            "status": {"const": "unavailable"},
            "reason": {"const": "collection-disabled"},
            "strategy": {"const": "deterministic-hash"},
            "sample_every": {"type": "integer", "minimum": 1},
            "eligible_scopes": {"const": 0},
            "sampled_scopes": {"const": 0}
            ,"phases": {"const": []}
          }
        }
      ]
    },
    "phaseSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_scopes", "phase_id", "sampled_scopes"],
      "properties": {
        "phase_id": {"$ref": "#/$defs/identifier"},
        "eligible_scopes": {"type": "integer", "minimum": 0},
        "sampled_scopes": {"type": "integer", "minimum": 0}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "metrics",
        "phase_id",
        "scope_path",
        "succeeded",
        "thread_id",
        "worker_id"
      ],
      "properties": {
        "phase_id": {"$ref": "#/$defs/identifier"},
        "scope_path": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "consumer": {"$ref": "#/$defs/identifier"},
        "worker_id": {"$ref": "#/$defs/identifier"},
        "thread_id": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "metricAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "average",
        "aggregation",
        "maximum",
        "measured_count",
        "minimum",
        "name",
        "total",
        "unavailable_count",
        "unit",
        "unsupported_count"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "unit": {"$ref": "#/$defs/unit"},
        "aggregation": {"enum": ["sum", "sample-sum", "distribution"]},
        "measured_count": {"type": "integer", "minimum": 0},
        "unsupported_count": {"type": "integer", "minimum": 0},
        "unavailable_count": {"type": "integer", "minimum": 0},
        "total": {"type": ["number", "null"]},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "average": {"type": ["number", "null"]}
      }
    },
    "phaseAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_count",
        "metrics",
        "phase_id",
        "sample_count",
        "succeeded_count"
      ],
      "properties": {
        "phase_id": {"$ref": "#/$defs/identifier"},
        "sample_count": {"type": "integer", "minimum": 0},
        "succeeded_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/metricAggregate"}
        }
      }
    },
    "filesystemCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes_read",
        "content_read_bytes_unavailable",
        "content_reads",
        "consumer_repeated_content_reads",
        "consumer_unique_content_resources",
        "descriptor_parses",
        "directory_enumerations",
        "hashes",
        "language_parses",
        "measurement_metadata_lookups",
        "metadata_lookups",
        "path_normalizations"
      ],
      "properties": {
        "bytes_read": {"type": "integer", "minimum": 0},
        "content_read_bytes_unavailable": {"type": "integer", "minimum": 0},
        "content_reads": {"type": "integer", "minimum": 0},
        "consumer_repeated_content_reads": {"type": "integer", "minimum": 0},
        "consumer_unique_content_resources": {"type": "integer", "minimum": 0},
        "descriptor_parses": {"type": "integer", "minimum": 0},
        "directory_enumerations": {"type": "integer", "minimum": 0},
        "hashes": {"type": "integer", "minimum": 0},
        "language_parses": {"type": "integer", "minimum": 0},
        "measurement_metadata_lookups": {"type": "integer", "minimum": 0},
        "metadata_lookups": {"type": "integer", "minimum": 0},
        "path_normalizations": {"type": "integer", "minimum": 0}
      }
    },
    "filesystemConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes_read",
        "consumer",
        "content_read_bytes_unavailable",
        "content_reads",
        "consumer_repeated_content_reads",
        "consumer_unique_content_resources",
        "descriptor_parses",
        "directory_enumerations",
        "hashes",
        "language_parses",
        "measurement_metadata_lookups",
        "metadata_lookups",
        "path_normalizations"
      ],
      "properties": {
        "consumer": {"$ref": "#/$defs/identifier"},
        "bytes_read": {"type": "integer", "minimum": 0},
        "content_read_bytes_unavailable": {"type": "integer", "minimum": 0},
        "content_reads": {"type": "integer", "minimum": 0},
        "consumer_repeated_content_reads": {"type": "integer", "minimum": 0},
        "consumer_unique_content_resources": {"type": "integer", "minimum": 0},
        "descriptor_parses": {"type": "integer", "minimum": 0},
        "directory_enumerations": {"type": "integer", "minimum": 0},
        "hashes": {"type": "integer", "minimum": 0},
        "language_parses": {"type": "integer", "minimum": 0},
        "measurement_metadata_lookups": {"type": "integer", "minimum": 0},
        "metadata_lookups": {"type": "integer", "minimum": 0},
        "path_normalizations": {"type": "integer", "minimum": 0}
      }
    },
    "filesystemOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "observed_resources"],
      "properties": {
        "consumers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "observed_resources": {"type": "integer", "minimum": 1}
      }
    },
    "filesystemContentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_overlaps",
        "observed_reads",
        "observed_repeated_reads",
        "observed_unique",
        "resource_limit_reached",
        "resource_tracking_limit",
        "tracking_reason",
        "tracking_status",
        "untracked_reads"
      ],
      "properties": {
        "consumer_overlaps": {
          "type": "array",
          "items": {"$ref": "#/$defs/filesystemOverlap"}
        },
        "observed_reads": {"type": "integer", "minimum": 0},
        "observed_repeated_reads": {"type": "integer", "minimum": 0},
        "observed_unique": {"type": "integer", "minimum": 0},
        "resource_limit_reached": {"type": "boolean"},
        "resource_tracking_limit": {"type": "integer", "minimum": 1},
        "tracking_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "collection-disabled",
            "identity-unavailable",
            "resource-limit-reached"
          ]
        },
        "tracking_status": {
          "enum": ["measured", "partial", "unavailable"]
        },
        "untracked_reads": {"type": "integer", "minimum": 0}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumers", "content_resources", "coverage", "totals"],
      "properties": {
        "coverage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "status"],
              "properties": {
                "status": {"const": "partial"},
                "reason": {"const": "explicit-instrumentation-boundaries"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "status"],
              "properties": {
                "status": {"const": "unavailable"},
                "reason": {"const": "collection-disabled"}
              }
            }
          ]
        },
        "content_resources": {"$ref": "#/$defs/filesystemContentResources"},
        "totals": {"$ref": "#/$defs/filesystemCounters"},
        "consumers": {
          "type": "array",
          "items": {"$ref": "#/$defs/filesystemConsumer"}
        }
      }
    }
  }
}
